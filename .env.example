# Copy to .env (git-ignored). Docker Compose and the backend both read it.

# Required for the Docker stack (KYC_ENV=production there): a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KYC_JWT_SECRET=

# Local development only (the Docker stack sets its own database URL).
KYC_DATABASE_URL=postgresql+psycopg://kyc:kyc@localhost:5432/kyc

# Optional
# KYC_TOKEN_HOURS=8
# KYC_UI_PORT=8080
# KYC_DB_PORT=5432
# KYC_SEED_CLIENTS=25
# ANTHROPIC_API_KEY=          # only for agents run live (python -m kyc.worker --live A3,A4)
